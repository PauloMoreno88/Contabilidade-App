# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
# Cookie domain for cross-subdomain sessions in production, e.g. .exactracontabilidade.com.br
AUTH_COOKIE_DOMAIN=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# App
WEB_ORIGIN=http://localhost:3000
CHECKOUT_ENABLED=false

# Stripe (TEST mode keys only until prices are validated by the accountant)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_NOTIFY_EMAIL=
