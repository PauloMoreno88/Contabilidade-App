PORT=3001
NODE_ENV=development

# Database (Neon Postgres). Use the pooled connection string from the Neon dashboard.
# Pooled (host with -pooler) for the app; direct (same host without -pooler) for prisma migrate.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=verify-full
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=verify-full

# Better Auth (secret: `openssl rand -base64 32`)
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3001
# Cookie domain for cross-subdomain sessions in production, e.g. .exactracontabilidade.com.br (empty in dev)
AUTH_COOKIE_DOMAIN=
# First admin, created by `pnpm --filter api seed`
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# App. WEB_ORIGIN accepts a comma-separated list (CORS + Better Auth trusted origins)
WEB_ORIGIN=http://localhost:3000
CHECKOUT_ENABLED=false

# Stripe (TEST mode keys only until prices are validated by the accountant)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# true = card checkout offers installments (up to 12x) on the annual price. Only turn on after
# confirming in Stripe test mode that the account supports installments for BRL cards.
STRIPE_CARD_INSTALLMENTS=false

# Resend (without RESEND_API_KEY, e-mails are only logged; required in production)
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Exactra <contato@envio.exactracontabilidade.com.br>.
# onboarding@resend.dev = test mode: Resend only delivers to the account owner.
EMAIL_FROM=
# Real mailbox that receives customers' replies (the sending address is not a mailbox). Optional.
EMAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=
# Public site origin for e-mail assets (logo at {base}/email/logo.png) and the renewal link.
# Dev: http://localhost:3000 (run the web app). Production: https://www.exactracontabilidade.com.br
EMAIL_ASSET_BASE_URL=http://localhost:3000

# Customer area files (Cloudflare R2, S3 API). Without them: local disk in dev (STORAGE_LOCAL_DIR,
# served by the API itself) and uploads disabled in production. The bucket needs CORS for WEB_ORIGIN.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: another S3-compatible endpoint instead of https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
STORAGE_LOCAL_DIR=.storage
