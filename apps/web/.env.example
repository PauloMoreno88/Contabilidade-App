# apps/web — public build variables.
# NEXT_PUBLIC_* values are inlined into the static files at `next build`: everyone who opens the
# site can read them, so never put secrets here. Changing any of them requires a new build.
# Local: copy to .env.local. Render: set them in the Static Site's environment.

# Which environment this build is for: "staging" (published test environment) or "production".
# Default: production. Staging shows the "Ambiente de testes" banner, the Stripe test cards on the
# checkout, adds <meta name="robots" content="noindex,nofollow"> to every page, and serves a
# robots.txt that blocks everything (empty sitemap).
NEXT_PUBLIC_APP_ENV=staging

# Public URL of apps/api, without a trailing slash. Production builds FAIL if it is missing or
# points to localhost. Example: https://api.exactracontabilidade.com.br
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public origin of this site (robots.txt, sitemap.xml, absolute metadata URLs).
# Default: https://www.exactracontabilidade.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Online checkout. "true" shows the pay button; anything else shows the WhatsApp fallback.
# Keep false in production until the accountant validates prices.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# "true" = in-browser mocks instead of apps/api (local work only). Not allowed in production builds.
NEXT_PUBLIC_USE_MOCK=false
